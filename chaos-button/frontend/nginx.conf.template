# Templated by docker-entrypoint.sh (envsubst) at container startup.
# ${LISTEN_PORT}, ${BACKEND_HOST}, ${BACKEND_PORT} are substituted;
# everything else ($host, $remote_addr, ...) is left for nginx itself.
server {
    listen ${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API calls to the backend's in-cluster ClusterIP Service.
    # The frontend is the only component exposed externally (e.g. via a
    # LoadBalancer Service); the backend never needs to be reachable from
    # outside the cluster.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
